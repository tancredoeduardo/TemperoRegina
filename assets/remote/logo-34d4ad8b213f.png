					</button>
								<a href="https://temperoregina.com.br" style="position: relative; top: -110px;"><img src="https://temperoregina.com.br/lib/img/logo-footer.png" class="img-fluid main-logo"></a>				
							</div>
			<div class="col-lg-9">
				<nav class="navbar navbar-expand-md navbar-light">
					<div class="collapse navbar-collapse" id="navbarTogglerDemo02">
