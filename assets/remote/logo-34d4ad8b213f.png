	<!-- Modal -->
<div class="modal fade" id="trabalheconosco" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
	<div class="modal-dialog" role="document">
		<form class="modal-content" onsubmit="mySubmit(this,'trabalhe');return false">
			<div class="modal-header">
				<h5 class="modal-title" id="exampleModalLabel">Trabalhe Conosco</h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<div class="modal-body">
				<p>Gostaria de fazer parte da nossa equipe? Então não deixe de nos enviar o seu currículo, basta preencher o formulário de identificação, anexar o seu currículo em formato DOC ou PDF e clicar em enviar.</p>
				<label class="form-group">
					Nome
					<input type="text" class="form-control" placeholder="Nome" name="nome">
				</label>
				<br>
				<label class="form-group">
					Email
					<input type="text" class="form-control" placeholder="Email" name="email">
				</label>
				<label class="form-group">
					Telefone
					<input type="text" class="form-control" placeholder="Telefone" name="telefone">
				</label>
				<div class="custom-file">
					<label class="custom-file-label" for="customFile">Curriculo</label><br>
					<input type="file" class="custom-file-input" id="customFile" name="arquivo">
				</div>
			</div>
			<div class="modal-footer">
				<button type="submit" class="btn btn-primary">Enviar</button>
			</div>
		</form>
	</div>
</div>

<div class="modal fade" id="sejaumrevendedor" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
	<div class="modal-dialog" role="document">
		<form class="modal-content" action="">
			<div class="modal-header">
				<h5 class="modal-title" id="exampleModalLabel">Seja um revendedor</h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<div class="modal-body">
				<p>Você é lojista e deseja cadastrar sua revenda? Preencha os dados abaixo e aguarde nosso contato.</p>
				<p>Dados da Empresa</p>
				<div class="form-group">
					<input type="text" class="form-control" placeholder="Razão Social" name="razao">
				</div>
				<div class="form-group">
					<input type="text" class="form-control" placeholder="Nome Fantasia" name="fantazia">
				</div>
				<div class="form-group">
					<input type="text" class="form-control" placeholder="CNPJ" name="cnpj">
				</div>
				<p>Contatos</p>
				<div class="form-group">
					<input type="text" class="form-control" placeholder="Nome" name="nome">
				</div>
				<div class="form-group">
					<input type="text" class="form-control" placeholder="E-mail" name="email">
				</div>
				<div class="form-group">
					<input type="text" class="form-control" placeholder="Telefone" name="telefone">
				</div>
				<div class="form-group">
					<input type="text" class="form-control" placeholder="Mensagem" name="mensagem">
				</div>
			</div>
			<div class="modal-footer">
				<button type="submit" class="btn btn-primary">Enviar</button>
			</div>
		</form>
	</div>
</div>

<div class="modal fade" id="sejanossoparceiro" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
	<div class="modal-dialog" role="document">
		<form class="modal-content" action="">
			<div class="modal-header">
