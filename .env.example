# Supabase publico do frontend
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_ADMIN_ACCESS_KEY=

# Seguranca: nao coloque chaves privadas no frontend ou na Vercel deste site.
# Nunca use aqui: SUPABASE_SERVICE_ROLE_KEY, SUPABASE_SECRET_KEY,
# SUPABASE_JWT_SECRET, POSTGRES_PASSWORD ou DATABASE_URL.

# Painel /admin: protecao simples de interface. Para seguranca real, evoluir para Supabase Auth.

# Opcional: tabela usada pelos formularios e newsletter
SUPABASE_SUBMISSIONS_TABLE=site_submissions
SUPABASE_HEALTHCHECK_INSERT=0

# Origem principal do site em producao, ex: https://www.seudominio.com.br
SITE_ORIGIN=

# Origens extras separadas por virgula, util para previews/autorizacoes temporarias
ALLOWED_ORIGINS=

# Webhook para leads comerciais (contact, newsletter, revendedores)
CRM_WEBHOOK_URL=

# Webhook para eventos de analytics
ANALYTICS_WEBHOOK_URL=
