{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "installCommand": "npm ci --omit=dev",
  "buildCommand": "npm run build",
  "functions": {
    "api/**/*.js": {
      "excludeFiles": "{assets/**,download/**,chrome-profile*/**,visual-report/**,node_modules/**,*.html,*.css,*.map,*.log,*.png,*.jpg,*.jpeg,*.webp,*.pdf,index-*.js,config-*.js,enhancements.js,server.js}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/download/(.*)",
      "destination": "/download/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/download/catalogo-regina.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"catalogo-regina.pdf\""
        }
      ]
    }
  ]
}
