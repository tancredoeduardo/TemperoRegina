{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "public",
  "installCommand": "npm ci --omit=dev",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/download/(.*)",
      "destination": "/download/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/download/catalogo-regina.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"catalogo-regina.pdf\""
        }
      ]
    }
  ]
}
